# ==========================================
# Spaces Network - Environment Configuration Template
# DO NOT commit real secrets to version control.
# ==========================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgres://username:password@localhost:5432/spaces_db?sslmode=prefer"

# Authentication & Cryptographic Keys (Min 32 characters)
AUTH_SECRET="your-super-secret-random-32-character-auth-key-change-me"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudinary Storage & CDN Delivery
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# RabbitMQ Image Processing Pipeline
RABBITMQ_URL="amqp://localhost:5672"
RABBITMQ_QUEUE="spaces_image_processing"
